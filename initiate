set -C

NAME="YOUR NAME"
LICENCE=ISC
[ "$1" = "-0" ] && LICENCE=0BSD

sed "1s/YEAR/$(date +%Y)/; 1s/NAME/$NAME/" "$HOME/.local/share/initiate/$LICENCE" > LICENSE || exit 1

cat > README <<'EOF'
